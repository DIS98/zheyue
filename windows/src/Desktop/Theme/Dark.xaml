<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色主题：不用纯黑，避免 OLED 上的拖影感；卡片比底色亮一档 -->
    <SolidColorBrush x:Key="Bg"          Color="#111318" />
    <SolidColorBrush x:Key="Panel"       Color="#191C22" />
    <SolidColorBrush x:Key="Panel2"      Color="#20242B" />
    <SolidColorBrush x:Key="Panel3"      Color="#262B34" />
    <SolidColorBrush x:Key="Line"        Color="#2A2F38" />
    <SolidColorBrush x:Key="LineStrong"  Color="#3B424E" />

    <SolidColorBrush x:Key="Fg"          Color="#E9EBEF" />
    <SolidColorBrush x:Key="Fg2"         Color="#A6ADB8" />
    <SolidColorBrush x:Key="Fg3"         Color="#737B88" />

    <SolidColorBrush x:Key="Accent"      Color="#5C8BFF" />
    <SolidColorBrush x:Key="Accent2"     Color="#8AA8FF" />
    <SolidColorBrush x:Key="AccentSoft"  Color="#1E2A44" />

    <SolidColorBrush x:Key="Ok"          Color="#3DD68C" />
    <SolidColorBrush x:Key="OkSoft"      Color="#14301F" />
    <SolidColorBrush x:Key="Warn"        Color="#F5A524" />
    <SolidColorBrush x:Key="WarnSoft"    Color="#33260F" />
    <SolidColorBrush x:Key="Bad"         Color="#F87171" />
    <SolidColorBrush x:Key="BadSoft"     Color="#3A1A1A" />

    <SolidColorBrush x:Key="Track"       Color="#3B424E" />
    <SolidColorBrush x:Key="Knob"        Color="#E9EBEF" />
    <SolidColorBrush x:Key="OnWhite"     Color="#0B0D11" />

    <Color x:Key="ShadowColor">#40000000</Color>
</ResourceDictionary>
