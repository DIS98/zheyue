<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色主题：底色偏冷灰，卡片纯白，强调色蓝 -->
    <SolidColorBrush x:Key="Bg"          Color="#F4F5F7" />
    <SolidColorBrush x:Key="Panel"       Color="#FFFFFF" />
    <SolidColorBrush x:Key="Panel2"      Color="#F7F8FA" />
    <SolidColorBrush x:Key="Panel3"      Color="#EEF0F4" />
    <SolidColorBrush x:Key="Line"        Color="#E5E7EB" />
    <SolidColorBrush x:Key="LineStrong"  Color="#D2D7DF" />

    <SolidColorBrush x:Key="Fg"          Color="#16181D" />
    <SolidColorBrush x:Key="Fg2"         Color="#5B626D" />
    <SolidColorBrush x:Key="Fg3"         Color="#8B93A0" />

    <SolidColorBrush x:Key="Accent"      Color="#2F6BFF" />
    <SolidColorBrush x:Key="Accent2"     Color="#6E8CFF" />
    <SolidColorBrush x:Key="AccentSoft"  Color="#EAF0FF" />

    <SolidColorBrush x:Key="Ok"          Color="#15803D" />
    <SolidColorBrush x:Key="OkSoft"      Color="#E7F7ED" />
    <SolidColorBrush x:Key="Warn"        Color="#B45309" />
    <SolidColorBrush x:Key="WarnSoft"    Color="#FEF2E0" />
    <SolidColorBrush x:Key="Bad"         Color="#DC2626" />
    <SolidColorBrush x:Key="BadSoft"     Color="#FDECEC" />

    <SolidColorBrush x:Key="Track"       Color="#C9CFD9" />
    <SolidColorBrush x:Key="Knob"        Color="#FFFFFF" />
    <SolidColorBrush x:Key="OnWhite"     Color="#FFFFFF" />

    <Color x:Key="ShadowColor">#18000000</Color>
</ResourceDictionary>
