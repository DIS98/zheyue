<local:PageBase x:Class="ClashDeck.Views.ConnsView"
             xmlns:local="clr-namespace:ClashDeck.Views"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具条 -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="13,10" Margin="0,0,0,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="活动连接" Style="{StaticResource H2}" VerticalAlignment="Center" />
                    <TextBlock x:Name="Tip" Style="{StaticResource Sub}" Margin="10,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Grid Width="220">
                        <TextBox x:Name="Search" TextChanged="Search_TextChanged" />
                        <TextBlock Text="过滤主机 / 进程 / 规则" FontSize="12" Foreground="{DynamicResource Fg3}"
                                   Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   x:Name="SearchHint" />
                    </Grid>
                    <Border Background="{DynamicResource Panel2}" CornerRadius="9" Padding="3" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ViewList" GroupName="connview" Style="{StaticResource Seg}"
                                         Content="单条" IsChecked="True" Checked="View_Checked" />
                            <RadioButton x:Name="ViewProc" GroupName="connview" Style="{StaticResource Seg}"
                                         Content="按进程" Checked="View_Checked" />
                        </StackPanel>
                    </Border>
                    <Button Content="刷新" Style="{StaticResource Btn}" Height="32" Margin="8,0,0,0"
                            Click="Refresh_Click" />
                    <Button x:Name="CloseAllBtn" Content="全部断开" Style="{StaticResource BtnDanger}" Height="32" Margin="8,0,0,0"
                            IsEnabled="False"
                            Click="CloseAll_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 表格 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 表头 -->
                <Border Grid.Row="0" Background="{DynamicResource Panel2}" CornerRadius="12,12,0,0"
                        Padding="14,9" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                    <Grid x:Name="HeaderRow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="146" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="112" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="主机" Style="{StaticResource Sub}" />
                        <TextBlock Grid.Column="1" Text="链路" Style="{StaticResource Sub}" />
                        <TextBlock Grid.Column="2" Text="规则" Style="{StaticResource Sub}" />
                        <TextBlock Grid.Column="3" Text="上传" Style="{StaticResource Sub}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="下载" Style="{StaticResource Sub}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="进程" Style="{StaticResource Sub}" Margin="14,0,0,0" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                    <ItemsControl x:Name="ConnList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="row" Padding="14,7" Background="Transparent" Cursor="Hand"
                                        BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                                        MouseLeftButtonUp="Row_Click" Tag="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="146" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="112" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Host}" FontSize="12" Foreground="{DynamicResource Fg}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Chains}" FontSize="11.5"
                                                   Foreground="{DynamicResource Fg2}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding RuleText}" FontSize="11.5"
                                                   Foreground="{DynamicResource Fg3}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding Up}" FontSize="11.5"
                                                   Foreground="{DynamicResource Fg2}" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding Down}" FontSize="11.5"
                                                   Foreground="{DynamicResource Fg2}" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="{Binding ProcessName}" FontSize="11.5"
                                                   Foreground="{DynamicResource Fg2}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Margin="14,0,0,0" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="row" Property="Background"
                                                Value="{DynamicResource AccentSoft}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 按进程视图 -->
                <ScrollViewer x:Name="ProcScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed" Padding="0,0,4,0">
                    <ItemsControl x:Name="ProcList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,7" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource Fg}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="11.5"
                                                   Foreground="{DynamicResource Fg2}" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Up}" FontSize="11.5"
                                                   Foreground="{DynamicResource Fg2}" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding Down}" FontSize="11.5"
                                                   Foreground="{DynamicResource Fg2}" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding Chains}" FontSize="11.5"
                                                   Foreground="{DynamicResource Fg3}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Margin="16,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="当前没有活动连接" Style="{StaticResource Sub}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- 详情 -->
        <Border x:Name="DetailBox" Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0"
                Visibility="Collapsed" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="DetailHost" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="断开这一条" Style="{StaticResource BtnDanger}" Click="CloseOne_Click" />
                    <Button Content="收起" Style="{StaticResource Btn}" Margin="8,0,0,0" Click="HideDetail_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</local:PageBase>
