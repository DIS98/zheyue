<Window x:Class="ClashDeck.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="折跃"
        Width="1220" Height="806" MinWidth="980" MinHeight="600"
        Background="{DynamicResource Bg}"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="214" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================================================== 侧栏 -->
        <Border Grid.Column="0" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 品牌 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="18,20,18,20">
                    <Border Width="34" Height="34" CornerRadius="10" ClipToBounds="True">
                        <Image Source="/assets/logo.png" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="折跃" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg}" />
                        <TextBlock x:Name="VerRelease" Text="v0.0.0" FontSize="10.5"
                                   Foreground="{DynamicResource Fg3}" Margin="0,1,0,0" />
                        <TextBlock x:Name="VerFull" Text="完整 0.0.0.0" FontSize="10"
                                   Foreground="{DynamicResource Fg3}" Margin="0,1,0,0" Opacity="0.75" />
                    </StackPanel>
                </StackPanel>

                <!-- 导航 -->
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavOverview" Style="{StaticResource NavItem}" GroupName="nav"
                                 IsChecked="True" Tag="overview" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Width="26" VerticalAlignment="Center" />
                            <TextBlock Text="概览" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavProxies" Style="{StaticResource NavItem}" GroupName="nav"
                                 Tag="proxies" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Width="26" VerticalAlignment="Center" />
                            <TextBlock Text="代理" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavConns" Style="{StaticResource NavItem}" GroupName="nav"
                                 Tag="conns" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Width="26" VerticalAlignment="Center" />
                            <TextBlock Text="连接" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavRules" Style="{StaticResource NavItem}" GroupName="nav"
                                 Tag="rules" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71C;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Width="26" VerticalAlignment="Center" />
                            <TextBlock Text="规则" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavLogs" Style="{StaticResource NavItem}" GroupName="nav"
                                 Tag="logs" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Width="26" VerticalAlignment="Center" />
                            <TextBlock Text="日志" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavProfiles" Style="{StaticResource NavItem}" GroupName="nav"
                                 Tag="profiles" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Width="26" VerticalAlignment="Center" />
                            <TextBlock Text="配置" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- 底部：内核状态 + 主题 -->
                <StackPanel Grid.Row="2" Margin="0,0,0,14">
                    <Border Margin="12,0" Padding="11,9" CornerRadius="9" Background="{DynamicResource Panel2}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="SideDot" Width="7" Height="7" Fill="{DynamicResource Fg3}"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="SideState" Text="未启动" FontSize="11.5" Margin="7,0,0,0"
                                           Foreground="{DynamicResource Fg2}" />
                            </StackPanel>
                            <TextBlock x:Name="SideNode" Text="—" FontSize="10.5" Foreground="{DynamicResource Fg3}"
                                       Margin="14,4,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnTheme" Style="{StaticResource BtnGhost}" Height="30" Margin="10,6,10,0"
                            HorizontalContentAlignment="Left" Padding="10,0" Click="BtnTheme_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ThemeIcon" Text="&#xE708;" FontFamily="{StaticResource IconFont}"
                                       FontSize="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="ThemeText" Text="切换到深色" FontSize="12" Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================================================== 主区 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶栏 -->
            <Grid Grid.Row="0" Margin="24,20,24,16">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PageTitle" Style="{StaticResource H1}" Text="概览" />
                        <!-- 徽章：只描述"此刻配置与运行态的关系"，不写"刚才发生了什么"（契约零-b） -->
                        <StackPanel x:Name="BadgeHost" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="PageSub" Style="{StaticResource Sub}" Text="" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Style="{StaticResource Pill}" Background="{DynamicResource Panel2}"
                            Margin="0,0,10,0" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="TopDot" Width="6" Height="6" Fill="{DynamicResource Fg3}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="TopState" Text="未启动" FontSize="11.5" Margin="6,0,0,0"
                                       Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnRestart" Style="{StaticResource Btn}" Content="重启内核" Height="30"
                            Margin="0,0,8,0" Padding="12,0" Click="BtnRestart_Click" />
                    <Button x:Name="BtnToggle" Style="{StaticResource BtnPrimary}" Content="启动" Width="92"
                            Height="30" Click="BtnToggle_Click" />
                </StackPanel>
            </Grid>

            <!-- 页面容器 -->
            <ContentControl Grid.Row="1" x:Name="PageHost" Margin="24,0,24,18" />

            <!-- 启动遮罩 -->
            <Border Grid.RowSpan="2" x:Name="Splash" Background="{DynamicResource Bg}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                    <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource Accent}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" Foreground="#FFFFFF"
                                   FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="SplashTitle" Text="折跃" FontSize="17" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,18,0,0"
                               Foreground="{DynamicResource Fg}" />
                    <TextBlock x:Name="SplashText" Text="正在启动后端…" FontSize="12"
                               Foreground="{DynamicResource Fg3}" HorizontalAlignment="Center"
                               Margin="0,7,0,0" TextAlignment="Center" TextWrapping="Wrap" LineHeight="19" />
                    <Button x:Name="SplashRetry" Style="{StaticResource Btn}" Content="重试"
                            HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="Collapsed"
                            Click="SplashRetry_Click" />
                    <!-- 端口被占时才出现：点它会先把新端口写进 config.json 再重启后端。
                         不自动换，是因为端口的用途只有用户知道（可能有别的程序/脚本指着它）。 -->
                    <Button x:Name="SplashFixPort" Style="{StaticResource Btn}" Content="换个端口"
                            HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"
                            Click="SplashFixPort_Click" />
                </StackPanel>
            </Border>

            <!-- 轻提示 -->
            <Border x:Name="ToastBox" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="0,0,0,24" Padding="16,9" CornerRadius="10" Visibility="Collapsed"
                    Background="{DynamicResource Panel}" BorderBrush="{DynamicResource LineStrong}"
                    BorderThickness="1">
                <TextBlock x:Name="ToastText" FontSize="12" TextWrapping="Wrap" MaxWidth="560" />
            </Border>
        </Grid>
    </Grid>
</Window>
