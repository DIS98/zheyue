<local:PageBase x:Class="ClashDeck.Views.OverviewView"
             xmlns:local="clr-namespace:ClashDeck.Views"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ClashDeck.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
        <StackPanel>

            <!-- 未就绪提示 -->
            <Border x:Name="Banner" Background="{DynamicResource WarnSoft}" CornerRadius="10"
                    Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{DynamicResource Warn}" VerticalAlignment="Center" />
                    <TextBlock x:Name="BannerText" Margin="9,0,0,0" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource Warn}" TextWrapping="Wrap" />
                    <Button x:Name="BannerBtn" Content="去配置" Style="{StaticResource BtnSm}"
                            Margin="14,0,0,0" Click="BannerBtn_Click" />
                    <!-- 失联态的主动作：重启后端（不是重启内核，也不是去配置） -->
                    <Button x:Name="BannerRestart" Content="重启后端" Style="{StaticResource BtnSm}"
                            Margin="14,0,0,0" Visibility="Collapsed" Click="BannerRestart_Click" />
                </StackPanel>
            </Border>

            <!-- 第一行：流量 + 接管 -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.72*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,14,16,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock Style="{StaticResource H2}" Text="实时流量" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Sub}" HorizontalAlignment="Right" Text="近 10 分钟" />
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x2193;" FontSize="16" Foreground="{DynamicResource Accent}"
                                               VerticalAlignment="Bottom" Margin="0,0,6,2" />
                                    <TextBlock x:Name="DownSpeed" Text="0 B/s" FontSize="23" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg}" />
                                </StackPanel>
                                <TextBlock Text="下行" Style="{StaticResource Sub}" Margin="22,0,0,0" />
                            </StackPanel>
                            <StackPanel Margin="26,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x2191;" FontSize="16" Foreground="{DynamicResource Warn}"
                                               VerticalAlignment="Bottom" Margin="0,0,6,2" />
                                    <TextBlock x:Name="UpSpeed" Text="0 B/s" FontSize="23" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg}" />
                                </StackPanel>
                                <TextBlock Text="上行" Style="{StaticResource Sub}" Margin="22,0,0,0" />
                            </StackPanel>
                            <StackPanel Margin="26,0,0,0">
                                <TextBlock x:Name="ConnCount" Text="0" FontSize="23" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Fg}" />
                                <TextBlock Text="连接" Style="{StaticResource Sub}" />
                            </StackPanel>
                        </StackPanel>

                        <ctl:TrafficChart x:Name="Chart" Grid.Row="2" Height="130" Margin="0,10,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="接管方式" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="系统代理" FontSize="12.5" Foreground="{DynamicResource Fg}" />
                                <!-- 9 态文案由代码渲染：持久控件只写状态，不写"刚才发生了什么" -->
                                <TextBlock x:Name="SwSysProxyHint" Text="浏览器与桌面应用走代理"
                                           Style="{StaticResource Sub}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                <Button x:Name="SwSysProxyFix" Content="打开 Windows 代理设置"
                                        Style="{StaticResource BtnSm}" HorizontalAlignment="Left"
                                        Margin="0,6,0,0" Visibility="Collapsed" Click="SwSysProxyFix_Click" />
                            </StackPanel>
                            <CheckBox x:Name="SwSysProxy" Grid.Column="1" Style="{StaticResource Toggle}"
                                      VerticalAlignment="Center" Click="SwSysProxy_Click" />
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,11" />

                        <!-- 分流模式：兜底走哪儿，决定了没点名的流量会不会经过机场 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
<StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="分流模式" FontSize="12.5"
                                               Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{DynamicResource Panel2}" CornerRadius="9" Padding="3">
                                        <UniformGrid Columns="2">
                                            <Button x:Name="SegSmart" Content="智能" Style="{StaticResource SegBtn}"
                                                    MinWidth="58" Click="SetSmart_Click" />
                                            <Button x:Name="SegStrict" Content="严格" Style="{StaticResource SegBtn}"
                                                    MinWidth="58" Click="SetStrict_Click" />
                                        </UniformGrid>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="ModeHint" Style="{StaticResource Sub}" Margin="0,6,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,11" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="TUN 模式" FontSize="12.5" Foreground="{DynamicResource Fg}" />
                                <TextBlock Text="全局接管，需要管理员" Style="{StaticResource Sub}" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="SwTun" Grid.Column="1" Style="{StaticResource Toggle}"
                                      VerticalAlignment="Center" Click="SwTun_Click" />
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,11" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="增强分流规则" FontSize="12.5" Foreground="{DynamicResource Fg}" />
                                <TextBlock Text="内置约 15 万条规则；关掉则沿用订阅自带的" Style="{StaticResource Sub}"
                                           Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox x:Name="SwEnhanced" Grid.Column="1" Style="{StaticResource Toggle}"
                                      VerticalAlignment="Center" Click="SwEnhanced_Click" />
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,11" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="订阅自动更新" FontSize="12.5" Foreground="{DynamicResource Fg}" />
                                <TextBlock Text="间隔小时数，填 0 表示不自动更新" Style="{StaticResource Sub}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="TxtSubInterval" Width="58" TextAlignment="Center"
                                         LostFocus="SubInterval_LostFocus" />
                                <TextBlock Text="小时" Style="{StaticResource Sub}" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,11" />

                        <TextBlock Text="代理模式" FontSize="12.5" Foreground="{DynamicResource Fg}" />
                        <Border Background="{DynamicResource Panel2}" CornerRadius="9" Padding="3" Margin="0,8,0,0">
                            <UniformGrid Columns="3">
                                <RadioButton x:Name="ModeRule" GroupName="mode" Style="{StaticResource Seg}"
                                             Content="规则" IsChecked="True" Checked="Mode_Checked" />
                                <RadioButton x:Name="ModeGlobal" GroupName="mode" Style="{StaticResource Seg}"
                                             Content="全局" Checked="Mode_Checked" />
                                <RadioButton x:Name="ModeDirect" GroupName="mode" Style="{StaticResource Seg}"
                                             Content="直连" Checked="Mode_Checked" />
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 第二行：三块摘要 -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="内核" />
                        <StackPanel x:Name="KvCore" Margin="0,11,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="当前配置" />
                        <StackPanel x:Name="KvProfile" Margin="0,11,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource H2}" Text="流量统计" />
                            <TextBlock x:Name="UsageTip" Style="{StaticResource Sub}" HorizontalAlignment="Right" />
                        </Grid>
                        <StackPanel x:Name="KvUsage" Margin="0,11,0,0" />
                        <StackPanel x:Name="UsageBars" Orientation="Horizontal" Height="52" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 第三行：主策略组 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource H2}" Text="主策略组" />
                        <TextBlock x:Name="GroupTip" Style="{StaticResource Sub}" HorizontalAlignment="Right" />
                    </Grid>
                    <StackPanel x:Name="GroupHost" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- 带宽测速（经代理实测，结果不落盘） -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource H2}" Text="带宽测速" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Sub}" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Text="经当前代理实测，结果不写入任何统计" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnDown" Content="测下行" Style="{StaticResource BtnSm}" Click="SpeedDown_Click" />
                            <Button x:Name="BtnUp" Content="测上行" Style="{StaticResource BtnSm}" Margin="8,0,0,0" Click="SpeedUp_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="SpeedResult" Style="{StaticResource Sub}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="点按钮开始测速。会消耗一些机场流量，测完不留任何文件。" />
                </StackPanel>
            </Border>

            <!-- 检查更新 -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource H2}" Text="版本更新" VerticalAlignment="Center" />
                            <TextBlock x:Name="UpdCurrent" Style="{StaticResource Sub}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Text="当前版本 —" />
                        </StackPanel>
                        <Button x:Name="BtnCheckUpdate" Content="检查更新" Style="{StaticResource BtnSm}"
                                HorizontalAlignment="Right" Click="CheckUpdate_Click" />
                    </Grid>
                    <TextBlock x:Name="UpdStatus" Style="{StaticResource Sub}" Margin="0,10,0,0"
                               TextWrapping="Wrap" Text="点「检查更新」看看有没有新版本。" />
                    <StackPanel x:Name="UpdActions" Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="Collapsed">
                        <Button x:Name="BtnDoUpdate" Content="下载并安装" Style="{StaticResource BtnPrimary}"
                                Click="DoUpdate_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</local:PageBase>
