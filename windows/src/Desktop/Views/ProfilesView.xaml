<local:PageBase x:Class="ClashDeck.Views.ProfilesView"
             xmlns:local="clr-namespace:ClashDeck.Views"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部操作条 -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="13,10" Margin="0,0,0,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="配置文件" Style="{StaticResource H2}" VerticalAlignment="Center" />
                    <TextBlock x:Name="Tip" Style="{StaticResource Sub}" Margin="10,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="导出备份" Style="{StaticResource Btn}" Height="30" Click="Backup_Click" />
                    <Button Content="导入备份" Style="{StaticResource Btn}" Height="30" Margin="8,0,0,0"
                            Click="RestorePick_Click" />
                    <Button Content="刷新" Style="{StaticResource Btn}" Height="30" Margin="8,0,0,0"
                            Click="Refresh_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,6,0">
            <StackPanel>

                <!-- 配置列表 -->
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                    <StackPanel x:Name="ProfileHost" />
                </Border>

                <!-- 导入订阅 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource H2}" Text="导入订阅" />
                            <TextBlock Style="{StaticResource Sub}" HorizontalAlignment="Right"
                                       Text="粘贴订阅链接，会自动下载并按设定间隔更新" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="124" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="名称（可留空）" Style="{StaticResource Sub}" Margin="1,0,0,5" />
                                <TextBox x:Name="SubName" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="订阅地址" Style="{StaticResource Sub}" Margin="1,0,0,5" />
                                <TextBox x:Name="SubUrl" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="自动更新" Style="{StaticResource Sub}" Margin="1,0,0,5" />
                                <ComboBox x:Name="SubInterval">
                                    <ComboBoxItem Content="关闭" Tag="0" />
                                    <ComboBoxItem Content="每 6 小时" Tag="6" />
                                    <ComboBoxItem Content="每 12 小时" Tag="12" IsSelected="True" />
                                    <ComboBoxItem Content="每 24 小时" Tag="24" />
                                    <ComboBoxItem Content="每 72 小时" Tag="72" />
                                </ComboBox>
                            </StackPanel>
                            <Button Grid.Column="6" Content="下载并导入" Style="{StaticResource BtnPrimary}"
                                    Height="32" VerticalAlignment="Bottom" Click="SubImport_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 测速设置 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource H2}" Text="测速" />
                            <TextBlock x:Name="TestUrlTip" Style="{StaticResource Sub}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="128" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="测速地址" Style="{StaticResource Sub}" Margin="1,0,0,5" />
                                <TextBox x:Name="TestUrl" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="超时（毫秒）" Style="{StaticResource Sub}" Margin="1,0,0,5" />
                                <TextBox x:Name="TestTimeout" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="定时自动测速" Style="{StaticResource Sub}" Margin="1,0,0,5" />
                                <ComboBox x:Name="AutoDelay">
                                    <ComboBoxItem Content="不自动" Tag="0" />
                                    <ComboBoxItem Content="每 5 分钟" Tag="5" />
                                    <ComboBoxItem Content="每 15 分钟" Tag="15" />
                                    <ComboBoxItem Content="每 30 分钟" Tag="30" />
                                    <ComboBoxItem Content="每 1 小时" Tag="60" />
                                </ComboBox>
                            </StackPanel>
                            <Button Grid.Column="6" Content="保存" Style="{StaticResource BtnPrimary}" Height="32"
                                    VerticalAlignment="Bottom" Click="TestSave_Click" />
                        </Grid>
                        <WrapPanel Margin="0,9,0,0">
                            <TextBlock Text="常用：" Style="{StaticResource Sub}" VerticalAlignment="Center" />
                            <Button Content="gstatic" Style="{StaticResource BtnSm}" Margin="4,0,0,0" Click="Preset_Click" Tag="https://www.gstatic.com/generate_204" />
                            <Button Content="google" Style="{StaticResource BtnSm}" Margin="6,0,0,0" Click="Preset_Click" Tag="https://www.google.com/generate_204" />
                            <Button Content="cloudflare" Style="{StaticResource BtnSm}" Margin="6,0,0,0" Click="Preset_Click" Tag="https://cp.cloudflare.com/generate_204" />
                            <Button Content="百度首页" Style="{StaticResource BtnSm}" Margin="6,0,0,0" Click="Preset_Click" Tag="https://www.baidu.com" />
                            <TextBlock Text="地址非法会被拒绝保存" Style="{StaticResource Sub}" Margin="12,0,0,0" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 内核与端口 + 启动联动 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource H2}" Text="内核与端口" />
                            <TextBlock Style="{StaticResource Sub}" HorizontalAlignment="Right"
                                       Text="改端口后需重启内核；改面板端口需重启应用" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="内核路径" Style="{StaticResource Sub}" Margin="1,0,0,5" />
                                <TextBox x:Name="CorePath" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="混合端口" Style="{StaticResource Sub}" Margin="1,0,0,5" />
                                <TextBox x:Name="MixedPort" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="控制端口" Style="{StaticResource Sub}" Margin="1,0,0,5" />
                                <TextBox x:Name="CtrlPort" />
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="面板端口" Style="{StaticResource Sub}" Margin="1,0,0,5" />
                                <TextBox x:Name="WebPort" />
                            </StackPanel>
                            <Button Grid.Column="8" Content="保存" Style="{StaticResource BtnPrimary}" Height="32"
                                    VerticalAlignment="Bottom" Click="PortSave_Click" />
                        </Grid>

                        <Border Style="{StaticResource Divider}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="启动时自动运行内核" FontSize="12.5" Foreground="{DynamicResource Fg}" />
                                <TextBlock Text="应用一起来就把内核拉起来，不用手动点启动"
                                           Style="{StaticResource Sub}" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="SwAutoCore" Grid.Column="1" Style="{StaticResource Toggle}"
                                      VerticalAlignment="Center" Click="SwAutoCore_Click" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="启动时自动开系统代理" FontSize="12.5" Foreground="{DynamicResource Fg}" />
                                <TextBlock Text="依赖上一项；停内核时会自动关代理，不会让机器断网"
                                           Style="{StaticResource Sub}" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="SwAutoProxy" Grid.Column="1" Style="{StaticResource Toggle}"
                                      VerticalAlignment="Center" Click="SwAutoProxy_Click" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="开机自启" FontSize="12.5" Foreground="{DynamicResource Fg}" />
                                <TextBlock Text="随 Windows 登录自动启动本应用（当前用户）"
                                           Style="{StaticResource Sub}" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="SwAutostart" Grid.Column="1" Style="{StaticResource Toggle}"
                                      VerticalAlignment="Center" Click="SwAutostart_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 合并订阅 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource H2}" Text="合并订阅" />
                            <TextBlock x:Name="MergeTip" Style="{StaticResource Sub}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="基础配置（提供规则与组结构）" Style="{StaticResource Sub}" Margin="1,0,0,5" />
                                <ComboBox x:Name="MergeBase" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="结果名称" Style="{StaticResource Sub}" Margin="1,0,0,5" />
                                <TextBox x:Name="MergeName" />
                            </StackPanel>
                            <Button Grid.Column="4" Content="生成" Style="{StaticResource BtnPrimary}" Height="32"
                                    VerticalAlignment="Bottom" Click="Merge_Click" />
                        </Grid>
                        <TextBlock Text="要合进来的订阅（可多选）" Style="{StaticResource Sub}" Margin="1,12,0,6" />
                        <WrapPanel x:Name="MergeExtras" />
                        <ContentControl x:Name="MergeResult" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- 粘贴 YAML -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource H2}" Text="粘贴 YAML" />
                            <TextBlock Style="{StaticResource Sub}" HorizontalAlignment="Right"
                                       Text="也可以把 .yaml 文件直接拖进窗口" />
                        </Grid>
                        <TextBox x:Name="PasteName" Margin="0,12,0,0" Height="32" />
                        <TextBox x:Name="PasteBox" Margin="0,8,0,0" Height="120" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="9,7"
                                 VerticalScrollBarVisibility="Auto" />
                        <Button Content="保存为新配置" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Right"
                                Margin="0,10,0,0" Click="PasteSave_Click" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:PageBase>
